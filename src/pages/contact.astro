---
import Base from "../layouts/Base.astro";
---
<Base title="お問い合わせ">
  <h1 class="page-title">お問い合わせ</h1>

  <section class="prose">
    <p>
      お問い合わせフォームは現在準備中です。しばらくお待ちください。
    </p>
  </section>
</Base>

<style>
  .page-title { font-size: 24px; margin: 0 0 24px; }
  .prose { max-width: 60ch; line-height: 1.9; }
  .prose p { color: var(--text-dim); margin: 0 0 16px; }
</style>
