---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/url.js";
import athletes from "../../data/athletes.json";
---
<Base title="選手一覧">
  <h1 class="page-title">選手一覧</h1>

  <form class="search-form" id="athlete-search-form">
    <input type="text" id="athlete-search-input" placeholder="選手名で検索" autocomplete="off" />
    <button type="submit">検索</button>
  </form>
  <p class="search-empty" id="athlete-search-empty" hidden>該当する選手が見つかりませんでした。</p>

  <ul class="athlete-list" id="athlete-list">
    {athletes.map((a) => (
      <li data-name={a.name}>
        <a href={withBase(`/athletes/${a.id}/`)}>
          <span class="athlete-name">{a.name}</span>
          <span class="athlete-pref">{a.prefecture} ／ {a.club}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<script>
  const form = document.getElementById("athlete-search-form") as HTMLFormElement;
  const input = document.getElementById("athlete-search-input") as HTMLInputElement;
  const empty = document.getElementById("athlete-search-empty") as HTMLElement;
  const items = document.querySelectorAll<HTMLLIElement>("#athlete-list li");

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = input.value.trim();
    let visibleCount = 0;
    items.forEach((li) => {
      const name = li.dataset.name ?? "";
      const match = q === "" || name.includes(q);
      li.hidden = !match;
      if (match) visibleCount++;
    });
    empty.hidden = visibleCount !== 0;
  });
</script>

<style>
  .page-title { font-size: 24px; margin: 0 0 16px; }

  .search-form {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }
  .search-form input {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    padding: 10px 12px;
    border-radius: 4px;
    font-size: 14px;
    font-family: "Noto Sans JP", sans-serif;
  }
  .search-form input:focus { outline: 1px solid var(--accent); }
  .search-form button {
    background: var(--accent);
    color: var(--text);
    border: none;
    padding: 0 20px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .search-form button:hover { opacity: 0.85; }
  .search-empty { color: var(--text-dim); font-size: 14px; padding: 12px 4px; }

  .athlete-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .athlete-list li { border-bottom: 1px solid var(--line); }
  .athlete-list a {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 4px; text-decoration: none; color: var(--text);
  }
  .athlete-list a:hover { background: var(--surface); }
  .athlete-name { font-weight: 500; }
  .athlete-pref { font-size: 13px; color: var(--text-dim); }
</style>
